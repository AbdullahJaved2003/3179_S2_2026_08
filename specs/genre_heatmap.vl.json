{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: each genre's share of all copies sold in each year, 1980–2015. Labels name the hit behind the darkest cells.",
  "data": {"url": "data/genre_year.csv"},
  "width": 900,
  "height": {"step": 24},
  "transform": [
    {"calculate": "toNumber(datum.Year)", "as": "Year"},
    {"calculate": "toNumber(datum.share)", "as": "share"},
    {"calculate": "toNumber(datum.sales)", "as": "sales"}
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "axis": {"labelAngle": 0, "values": [1980, 1985, 1990, 1995, 2000, 2005, 2010, 2015], "ticks": false, "domain": false, "orient": "top"}
    },
    "y": {
      "field": "Genre",
      "type": "nominal",
      "title": null,
      "sort": ["Action", "Sports", "Shooter", "Role-Playing", "Platform", "Misc", "Racing", "Fighting", "Simulation", "Puzzle", "Adventure", "Strategy"],
      "axis": {"ticks": false, "domain": false, "labelFontSize": 12, "labelPadding": 6}
    }
  },
  "layer": [
    {
      "params": [
        {"name": "hoverGenre", "select": {"type": "point", "fields": ["Genre"], "on": "mouseover", "clear": "mouseout"}}
      ],
      "mark": {"type": "rect", "stroke": "#FFFFFF", "strokeWidth": 1.2, "cornerRadius": 2},
      "encoding": {
        "color": {
          "field": "share",
          "type": "quantitative",
          "title": "Share of the year's sales",
          "scale": {"type": "pow", "exponent": 0.6, "domain": [0, 0.6], "clamp": true, "range": ["#FBF6EE", "#FBD9B0", "#F5A262", "#E0632F", "#B23A17", "#6B1D0B"]},
          "legend": {"orient": "bottom", "format": ".0%", "gradientLength": 260, "direction": "horizontal", "titleOrient": "left", "values": [0, 0.1, 0.2, 0.4, 0.6]}
        },
        "opacity": {"condition": {"param": "hoverGenre", "empty": true, "value": 1}, "value": 0.35},
        "tooltip": [
          {"field": "Genre"},
          {"field": "Year"},
          {"field": "share", "title": "Share of that year's sales", "format": ".1%"},
          {"field": "sales", "title": "Copies sold (millions)", "format": ",.1f"}
        ]
      }
    },
    {
      "data": {"url": "data/heatmap_notes.csv"},
      "transform": [{"calculate": "toNumber(datum.Year)", "as": "Year"}],
      "mark": {"type": "text", "fontSize": 11, "fontWeight": 700, "align": "left", "dx": -6, "stroke": "#FFFFFF", "strokeWidth": 3.5, "strokeJoin": "round", "opacity": 0.9},
      "encoding": {"text": {"field": "label"}}
    },
    {
      "data": {"url": "data/heatmap_notes.csv"},
      "transform": [{"calculate": "toNumber(datum.Year)", "as": "Year"}],
      "mark": {"type": "text", "fontSize": 11, "fontWeight": 700, "align": "left", "dx": -6, "color": "#2B2433"},
      "encoding": {"text": {"field": "label"}}
    }
  ]
}
