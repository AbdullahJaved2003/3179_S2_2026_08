            "align": "center",
            "baseline": "middle",
            "fontSize": 10.5,
            "lineHeight": 12.5,
            "fontWeight": 600,
            "color": "#2B2433"
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        },
        {
          "data": {
            "url": "data/publisher_hq.csv"
          },
          "transform": [
            {
              "filter": "datum.hub === 'NA' && datum.label_align === 'right'"
